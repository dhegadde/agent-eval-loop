# Copy only the settings you need into .env. Never commit real credentials.

# Existing/default OpenAI roles
OPENAI_API_KEY=replace-with-your-openai-key

# Staged candidate: move the high-volume executor only to private Qwen inference.
EVOAGENTX_EXECUTOR_PROVIDER=openai_compatible
EVOAGENTX_EXECUTOR_MODEL=Qwen/Qwen3.8-27B-FP8
EVOAGENTX_EXECUTOR_API_BASE=https://your-private-endpoint.example/v1
EVOAGENTX_EXECUTOR_API_KEY=replace-with-your-endpoint-key
EVOAGENTX_EXECUTOR_MAX_TOKENS=4096
# Required for the staged Qwen3.8 candidate; omit for generic endpoints.
